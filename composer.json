{
  "name": "local/claude-free-gateway",
  "description": "Workerman Anthropic Messages gateway for zero-cost B.AI models",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.3",
    "workerman/http-client": "^3.0",
    "workerman/workerman": "^5.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "FreeGateway\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FreeGateway\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
