# B.AI credential. Keep this file local: copy it to .env and insert a newly generated Key.
BAI_API_KEY=

# The proxy listens only on this PC. Do not change the host to 0.0.0.0.
PROXY_HOST=127.0.0.1
PROXY_PORT=8787

# Unknown Desktop model aliases fall back to this free B.AI model.
DEFAULT_UPSTREAM_MODEL=deepseek-v4-flash

# Set false to reject model aliases not listed in model_map() inside proxy.php.
ALLOW_UNKNOWN_MODELS=true

# Upstream request timeout in seconds.
UPSTREAM_TIMEOUT=180
